<Project>
  <!--
    Zig toolchain integration for componentize-dotnet.
    When UseZigToolchain=true, replaces wasi-sdk with zig for WASI compilation and linking.
    Zig must be on PATH. This eliminates the ~400MB wasi-sdk download.
  -->
  <PropertyGroup Condition="'$(UseZigToolchain)' == 'true'">
    <ZigExe Condition="'$(ZigExe)' == ''">zig</ZigExe>
    <_ZigTarget>wasm32-wasi</_ZigTarget>
  </PropertyGroup>

  <!--
    Override the WASI SDK initialization from Microsoft.NETCore.Native.Wasm.targets.
    We set CppCompiler/CppLinker/CppLibCreator to zig equivalents BEFORE the NativeAOT
    targets run, so the _InitializeWasiSdk target's error about missing WASI_SDK_PATH
    is avoided.
  -->
  <Target Name="_InitializeZigToolchain"
          BeforeTargets="_InitializeWasiSdk;SetupOSSpecificProps;PrepareWasmSdks"
          Condition="'$(UseZigToolchain)' == 'true' and '$(_targetOS)' == 'wasi'">

    <!-- Verify zig is available -->
    <Exec Command="$(ZigExe) version" ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_ZigVersion" />
    </Exec>
    <Message Importance="high" Text="Using Zig $(ZigVersion) as WASI toolchain (replacing wasi-sdk)" />

    <PropertyGroup>
      <!-- zig cc/c++ acts as clang with bundled sysroot + musl libc -->
      <CppCompiler>$(ZigExe) cc -target $(_ZigTarget)</CppCompiler>
      <CppLinker>$(ZigExe) cc -target $(_ZigTarget)</CppLinker>
      <CppLibCreator>$(ZigExe) ar</CppLibCreator>

      <!-- Prevent the NativeAOT targets from erroring about missing WASI_SDK_PATH -->
      <WASI_SDK_PATH>zig-provided</WASI_SDK_PATH>
    </PropertyGroup>
  </Target>

  <!--
    Adjust linker flags for zig's wasm-ld.
    zig's lld doesn't support all the same flags as wasi-sdk's wasm-ld.
  -->
  <Target Name="_AdjustZigLinkerFlags"
          BeforeTargets="LinkNativeLlvm"
          Condition="'$(UseZigToolchain)' == 'true' and '$(_targetOS)' == 'wasi'">
    <ItemGroup>
      <!-- zig's lld does not support the warn-unresolved-symbols flag; remove it -->
      <CustomLinkerArg Remove="-Wl,--warn-unresolved-symbols" />

      <!-- zig auto-defines _WASI_EMULATED_* macros when the lwasi-emulated-* libs are linked,
           but we also need them during compilation of any .c/.cpp files -->
      <CustomLinkerArg Remove="-lwasi-emulated-pthread" />
    </ItemGroup>
  </Target>

  <!--
    Skip the ObtainWasiSdk download target when using zig.
    (Handled by conditions on PrepareWasmSdks and ObtainWasiSdk in WitBindgen.targets)
  -->
</Project>
